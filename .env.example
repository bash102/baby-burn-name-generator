# Private content repo checkout; falls back to content.sample/ if missing
CONTENT_DIR=content
# SQLite db and generated files live here
DATA_DIR=data
# openai | gemini | fake (fake needs no network)
TRANSFORM_PROVIDER=fake
OPENAI_API_KEY=sk-placeholder
GEMINI_API_KEY=placeholder
# Provider model ids
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4.1-mini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash
# usb://0x04f9:0x209b for the Brother QL-800, or "file" to write PNGs instead
PRINTER=file
# PIN for the admin pages
ADMIN_PIN=0000
# Seconds to wait for the photo transform before giving up
TRANSFORM_TIMEOUT_S=25
# Random (non-fixed) quiz questions per guest
QUIZ_RANDOM_COUNT=4
# Warn the owner when unused approved names drop below this
LOW_NAMES_WARNING=25
# Seconds before an idle guest session expires
SESSION_TTL_S=600
# Photo bucket name
PHOTO_BUCKET=baby-burn-photos
# Public URL prefix of the bucket, no trailing slash
PHOTO_BASE_URL=https://photos.example.com
# Secret used to derive the album link
ALBUM_SECRET=change-me
# Days before hosted photos are deleted
PHOTO_RETENTION_DAYS=14
# S3-compatible endpoint (R2); leave empty for AWS
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
