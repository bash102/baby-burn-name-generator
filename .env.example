# Relative paths resolve against the repo root. CONTENT_DIR must exist if set;
# unset uses content/ if present, else content.sample/.
CONTENT_DIR=content
# Where the name database and generated files are stored
DATA_DIR=data
# openai | gemini | fake (fake needs no network)
TRANSFORM_PROVIDER=fake
OPENAI_API_KEY=sk-placeholder
GEMINI_API_KEY=placeholder
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4.1-mini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VISION_MODEL=gemini-2.5-flash
# usb://0x04f9:0x209b for the Brother QL-800, or "file" to write PNGs instead
PRINTER=file
ADMIN_PIN=change-me
TRANSFORM_TIMEOUT_S=25
QUIZ_RANDOM_COUNT=4
LOW_NAMES_WARNING=25
SESSION_TTL_S=600
PHOTO_BUCKET=baby-burn-photos
# Public URL prefix of the bucket; a trailing slash is stripped
PHOTO_BASE_URL=https://photos.example.com
ALBUM_SECRET=change-me
PHOTO_RETENTION_DAYS=14
# S3-compatible endpoint (R2); leave empty for AWS
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
