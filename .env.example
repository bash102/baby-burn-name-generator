# Relative paths resolve against the repo root. CONTENT_DIR must exist if set;
# unset uses content/ if present, else content.sample/.
CONTENT_DIR=content
# Where the name database and generated files are stored
DATA_DIR=data
# openai | gemini | fake (fake needs no network)
TRANSFORM_PROVIDER=fake
OPENAI_API_KEY=sk-placeholder
GEMINI_API_KEY=placeholder
# Model ids: defaults live in app/config.py; override only after the bake-off.
# OPENAI_IMAGE_MODEL=
# OPENAI_VISION_MODEL=
# GEMINI_IMAGE_MODEL=
# GEMINI_VISION_MODEL=
# usb://0x04f9:0x209b for the Brother QL-800, or "file" to write PNGs instead
PRINTER=file
ADMIN_PIN=change-me
# TLS kiosk listener (defaults shown; setup-pi.sh writes them from KIOSK_PORT/KIOSK_HOST)
# LISTEN_PORT=443
# TLS_CERT=certs/babyburn.local.pem
# TLS_KEY=certs/babyburn.local-key.pem
# Extra plain-HTTP listener on 127.0.0.1 only (git-deploy sets it in deploy/pi.toml); 0 = off
# LOCAL_HTTP_PORT=0
# Seconds the kiosk waits for the dusty photo before showing the original
TRANSFORM_TIMEOUT_S=25
# HTTP timeout for the AI call; a late photo still reaches the guest's phone page
PROVIDER_TIMEOUT_S=90
QUIZ_RANDOM_COUNT=4
LOW_NAMES_WARNING=25
SESSION_TTL_S=600
PHOTO_BUCKET=baby-burn-photos
# Public URL prefix of the bucket; a trailing slash is stripped
PHOTO_BASE_URL=https://photos.example.com
ALBUM_SECRET=change-me
# S3-compatible endpoint (R2); leave empty for AWS
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
# Print alignment: printer dots, ~12 per mm; +right/+down, -left/-up; range -60..60; border clips beyond ±25 (SAFE_INSET_PX in app/badge.py)
BADGE_OFFSET_X=0
BADGE_OFFSET_Y=0
# Bonus coloring page printed after the badge for about 1 in N guests (whole number; 0 = off)
COLORING_ODDS=8
# Pool of owner-reviewed coloring pages (*.png, *.jpg); empty = <CONTENT_DIR>/coloring
# (content/coloring/ in the private content repo). The bonus is inactive until it has pages.
COLORING_DIR=
