## Template: deploy/setup-pi.sh drops these "##" lines, substitutes @USER@ (login user), @REPO@ (checkout path)
## and @PORT_CAPS@ (AmbientCapabilities line when LISTEN_PORT < 1024, else a comment), and installs the result.
[Unit]
Description=Baby Burn name generator
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
# Run the checkout's venv python directly (created by `uv sync`): no resolve/sync at start, works offline.
ExecStart=@REPO@/.venv/bin/python -m app.web
Restart=always
RestartSec=3
@PORT_CAPS@

[Install]
WantedBy=multi-user.target
