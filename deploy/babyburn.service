## Template for deploy/setup-pi.sh. Placeholders: @USER@, @REPO@, @PORT_CAPS@ (AmbientCapabilities only when LISTEN_PORT < 1024). '##' lines are stripped on install.
[Unit]
Description=Baby Burn name generator
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
# Run the checkout's venv python directly (created by `uv sync`): no resolve/sync at start, works offline.
ExecStart=@REPO@/.venv/bin/python -m app.web
Restart=always
RestartSec=3
@PORT_CAPS@

[Install]
WantedBy=multi-user.target
